# NovelKit 面板运行参数（可选）。
#
#   cp webpanel/panel.env.example webpanel/panel.env
#
# 本机部署：全部保持默认即可 —— 监听 127.0.0.1:8897，只有本机能访问。
# 云服务器部署：见 deploy/cloud.md。

# 监听地址。127.0.0.1 = 只监听本机（配合 Nginx 反代最稳）。
# 设为 0.0.0.0 时**必须**同时设置 PANEL_TOKEN，否则面板拒绝启动。
PANEL_HOST=127.0.0.1
PANEL_PORT=8897

# 访问令牌。留空 = 不开认证（仅限本机模式）。
# 生成一个：
#   python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
#PANEL_TOKEN=
